rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function esPropietario(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function esAdministrador() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.activo == true;
    }

    function lugarValido() {
      let datos = request.resource.data;
      return datos.keys().hasAll([
          'nombre', 'descripcion', 'ubicacion', 'categoria',
          'costoOrientativo', 'horario', 'fechaActualizacion',
          'latitud', 'longitud'
        ])
        && datos.keys().hasOnly([
          'nombre', 'descripcion', 'ubicacion', 'categoria',
          'costoOrientativo', 'horario', 'fechaActualizacion',
          'fuenteUrl', 'imagenAsset', 'latitud', 'longitud'
        ])
        && datos.nombre is string
        && datos.descripcion is string
        && datos.ubicacion is string
        && datos.categoria is string
        && datos.costoOrientativo is string
        && datos.horario is string
        && datos.fechaActualizacion is string
        && (!('fuenteUrl' in datos) || datos.fuenteUrl is string)
        && datos.latitud is number
        && datos.longitud is number
        && ('imagenAsset' in datos)
        && datos.imagenAsset is string;
    }

    match /administradores/{userId} {
      allow get: if esPropietario(userId);
      allow list, create, update, delete: if false;
    }

    match /lugares/{lugarId} {
      allow read: if true;
      allow create, update: if esAdministrador() && lugarValido();
      allow delete: if esAdministrador();
    }

    match /users/{userId}/favoritos/{lugarId} {
      allow read, delete: if esPropietario(userId);
      allow create, update: if esPropietario(userId)
        && request.resource.data.keys().hasOnly(['lugarId', 'creadoEn'])
        && request.resource.data.keys().hasAll(['lugarId', 'creadoEn'])
        && request.resource.data.lugarId == lugarId
        && request.resource.data.creadoEn is timestamp;
    }

    match /users/{userId}/itinerario/{visitaId} {
      allow read, delete: if esPropietario(userId);
      allow create, update: if esPropietario(userId)
        && request.resource.data.keys().hasOnly(['lugarId', 'fecha'])
        && request.resource.data.keys().hasAll(['lugarId', 'fecha'])
        && request.resource.data.lugarId is string
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
